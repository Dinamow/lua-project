# Example environment variables file
# Set these with `lua env` (do not commit a real .env with secrets)

# --- BambooHR ---
# Not set directly here — connect the integration instead, which stores the
# API key securely in Lua's credential vault:
#   lua integrations connect --integration bamboohr --auth-method token
# Until that's connected, BambooHRService falls back to mock employee data.

# --- Google Sheets (performance dashboard) ---
# Service account with the Sheets API enabled; share the target sheet with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKey\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# --- Optional (from the base template) ---
# OPENAI_API_KEY=your-openai-api-key-here
# PINECONE_API_KEY=your-pinecone-api-key-here
# STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Note: Values in lua.skill.yaml will override values in this .env file
